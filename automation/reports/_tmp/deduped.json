aw/pull/97041/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/97041\">#97041</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4865173674\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/104919\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/104919/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/104919\">#104919</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4903446660\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/109108\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/109108/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/109108\">#109108</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4919940692\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/110954\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/110954/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/110954\">#110954</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4856574962\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/103793\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/103793/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/103793\">#103793</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4681372838\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/94016\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/94016/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/94016\">#94016</a>) Thanks <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/indulgeback/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/indulgeback\">@indulgeback</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/cuiyuxin-gif/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/cuiyuxin-gif\">@cuiyuxin-gif</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/Pick-cat/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/Pick-cat\">@Pick-cat</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/Glucksberg/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/Glucksberg\">@Glucksberg</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/evan-YM/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/evan-YM\">@evan-YM</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/zhangguiping-xydt/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/zhangguiping-xydt\">@zhangguiping-xydt</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/yetval/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/yetval\">@yetval</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/sheyanmin/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/sheyanmin\">@sheyanmin</a>, and <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/thomasthelen-kibeauftragter/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/thomasthelen-kibeauftragter\">@thomasthelen-kibeauftragter</a>.</li>\n<li><strong>Safer operator diagnostics:</strong> command and status surfaces keep owner-only actions protected and prevent credentials from appearing in account URLs or summaries. (<a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4779988171\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/98260\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/98260/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/98260\">#98260</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4886843047\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/107754\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/107754/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/107754\">#107754</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4865566038\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/105017\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/105017/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/105017\">#105017</a>) Thanks <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/eleqtrizit/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/eleqtrizit\">@eleqtrizit</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/joshavant/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/joshavant\">@joshavant</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/ooiuuii/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/ooiuuii\">@ooiuuii</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/aniruddhaadak80/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/aniruddhaadak80\">@aniruddhaadak80</a>, and <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/tzy-17/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/tzy-17\">@tzy-17</a>.</li>\n<li><strong>More robust local runtime state:</strong> SQLite checkpoints, workspace reads, gateway process signalling, plugin HTTP responses, and dependency handling no longer turn transient host conditions into failed runs. (<a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4794176448\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/99067\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/99067/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/99067\">#99067</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4819682538\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/100910\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/100910/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/100910\">#100910</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4835906001\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/102125\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/102125/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/102125\">#102125</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4907734092\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/109590\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/109590/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/109590\">#109590</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4942625061\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/112406\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/112406/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/112406\">#112406</a>) Thanks <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/ooiuuii/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/ooiuuii\">@ooiuuii</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/masatohoshino/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/masatohoshino\">@masatohoshino</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/vincentkoc/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/vincentkoc\">@vincentkoc</a>, <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/mushuiyu886/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/mushuiyu886\">@mushuiyu886</a>, and <a class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/krissding/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/krissding\">@krissding</a>.</li>\n</ul>\n<h3>Changes</h3>\n<ul>\n<li><strong>Extended-stable hardening:</strong> this maintenance release carries targeted security and reliability repairs without adding new release-line features.</li>\n</ul>\n<h3>Fixes</h3>\n<ul>\n<li><strong>OpenCode Go:</strong> use the documented <code>hy3</code> model identifier instead of the failing <code>hy3-preview</code> alias.</li>\n<li><strong>Codex native subagents:</strong> retain the parent app-server subscription and recognize multi-agent V2 child activity until a yielded child completion reaches its requester.</li>\n<li><strong>Dependency security:</strong> updates production dependency resolutions for patched <code>brace-expansion</code>, PostCSS, <code>fast-uri</code>, <code>ip-address</code>, and Undici versions. (<a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4972606253\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/113428\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/113428/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/113428\">#113428</a>, <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5052568696\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/118804\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/118804/hovercard\" href=\"https://github.com/openclaw/openclaw/pull/118804\">#118804</a>)</li>\n<li><strong>Execution and transport safety:</strong> browser, sandbox, exec, MCP, and secret-resolution paths reject unsafe inputs and handle stream failures without crashing the host process.</li>\n<li><strong>Delivery and channel stability:</strong> outbound receipts, delivery evidence, channel lifecycle, health monitoring, and gateway queues recover cleanly under retries, restarts, and overload.</li>\n<li><strong>Gateway and storage reliability:</strong> plugin responses, process probes, workspace bootstrap reads, and SQLite writes tolerate expected transient failures while preserving correct state.</li>\n</ul>\n<h3>Upcoming deprecations</h3>\n<ul>\n<li><strong>Plugin SDK migration:</strong> <code>before_agent_start</code>, root <code>openclaw/plugin-sdk</code> imports, <code>providerAuthEnvVars</code>, and <code>channelEnvVars</code> are scheduled for removal after July 24. Migrate to the modern hook stages, focused SDK subpath imports, and manifest setup descriptors. See <a href=\"/openclaw/openclaw/blob/v2026.6.34/plugins/sdk-migration\">Plugin SDK migration</a> and <a href=\"/openclaw/openclaw/blob/v2026.6.34/plugins/manifest\">plugin manifests</a>.</li>\n</ul>\n<h3>Complete contribution record</h3>\n<p>This audited record covers the complete v2026.6.33..<a class=\"commit-link\" data-hovercard-type=\"commit\" data-hovercard-url=\"https://github.com/openclaw/openclaw/commit/496c84bf6159bd09ce2c2a261c354ea641757b19/hovercard\" href=\"https://github.com/openclaw/openclaw/commit/496c84bf6159bd09ce2c2a261c354ea641757b19\"><tt>496c84b</tt></a> history plus release-validation backports: 25 merged PRs. The generation manifest also supplies direct commits as editorial input; the grouped notes above prioritize user impact.</p>\n<h4>Pull requests</h4>\n<ul>\n<li><strong>PR <a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4725862718\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openclaw/openclaw/issues/96100\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openclaw/openclaw/pull/